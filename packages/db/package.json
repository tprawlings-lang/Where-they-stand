{
  "name": "@where-they-stand/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "lint": "prisma generate && tsc --noEmit",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --exclude prisma/**/*.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:validate": "prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "test:db": "vitest run --reporter=verbose prisma/integrity.integration.test.ts prisma/phase1-acceptance.integration.test.ts",
    "pretest:db": "node -e \"if (!process.env.DATABASE_URL) { console.error(\\\"DATABASE_URL is required; refusing to skip PostgreSQL integration tests.\\\"); process.exit(1) }\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@where-they-stand/issue-definitions": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
